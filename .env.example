# =============================================================================
# OpenTrace — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# Never commit .env to version control.
# =============================================================================

# === ENVIRONMENT ===
ENVIRONMENT=development

# === POSTGRES ===
POSTGRES_USER=opentrace
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=opentrace
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_MAX_CONNS=20

# === CLICKHOUSE ===
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=opentrace
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# === REDPANDA ===
REDPANDA_BROKERS=redpanda:9092
REDPANDA_LOGS_TOPIC=opentrace.logs
REDPANDA_METRICS_TOPIC=opentrace.metrics
REDPANDA_TRACES_TOPIC=opentrace.traces

# === COLLECTOR SERVICE ===
COLLECTOR_PORT=8080
COLLECTOR_LOG_LEVEL=info
COLLECTOR_MAX_BATCH_SIZE=1000
COLLECTOR_MAX_PAYLOAD_BYTES=5242880
COLLECTOR_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# === QUERY API ===
QUERY_API_PORT=8081
QUERY_API_LOG_LEVEL=info
QUERY_API_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
QUERY_API_DEFAULT_PAGE_SIZE=100
QUERY_API_MAX_TIME_RANGE_DAYS=7

# === UI ===
UI_PORT=3000
# Empty: nginx proxies /api/* internally — no browser-visible API host needed
VITE_API_BASE_URL=

# === TESTING ===
# Used by integration tests (build tag: integration). Point to a dedicated test DB
# so tests never touch production data. Exposed when running docker-compose.dev.yml.
TEST_DATABASE_URL=postgres://opentrace:changeme_in_production@localhost:5432/opentrace
