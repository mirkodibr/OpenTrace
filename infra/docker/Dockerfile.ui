# syntax=docker/dockerfile:1.7

# Stage 1 — Build React app
FROM node:20-alpine AS builder

WORKDIR /app

# Cache node_modules separately from source
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefer-offline

COPY web/ .

ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

# Stage 2 — Serve via Nginx
FROM nginx:1.26-alpine AS runtime

# Remove default nginx config and default content
RUN rm /etc/nginx/conf.d/default.conf && \
    rm -rf /usr/share/nginx/html/*

COPY infra/docker/nginx.conf /etc/nginx/conf.d/opentrace.conf
COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx health endpoint — returns 200 for /health
RUN echo "server { listen 8080; location /health { return 200 'ok'; add_header Content-Type text/plain; } }" \
    > /etc/nginx/conf.d/health.conf

# Run as non-root
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown nginx:nginx /var/run/nginx.pid

USER nginx

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
